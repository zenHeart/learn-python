{
  "name": "learn-python",
  "version": "1.0.0",
  "description": "Python 交互式学习站点",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "check:links": "npm run docs:build && node .walkthrough/check-links.js",
    "check:examples": "bash .walkthrough/run-all.sh",
    "check:unpack": "python .walkthrough/evidence/unpack-claims-audit.py && python .walkthrough/evidence/concepts-round2-audit.py",
    "check:examples-claims": "python .walkthrough/evidence/examples-claims-audit.py",
    "check": "npm run check:links && npm run check:examples && npm run check:unpack && npm run check:examples-claims"
  },
  "dependencies": {
    "vitepress": "^1.5.0"
  }
}